{
  "uid": "project-14-apps",
  "title": "project-14 apps",
  "description": "Health, traffic, latency, host resources and logs for the project-14 apps, as shipped by Grafana Alloy.",
  "tags": [
    "project-14"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(up, env)",
          "refId": "env"
        },
        "definition": "label_values(up, env)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(up{env=~\"$env\"}, app)",
          "refId": "app"
        },
        "definition": "label_values(up{env=~\"$env\"}, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(up{env=~\"$env\", app=~\"$app\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(up{env=~\"$env\", app=~\"$app\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "search",
        "label": "Log search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Health (probe through nginx)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Alloy's blackbox probe of each instance's readiness URL. 1 = every instance of the app answers 2xx.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "min by (app) (probe_success{env=~\"$env\", app=~\"$app\", host=~\"$host\"})",
          "legendFormat": "{{app}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "description": "Laravel: php-fpm accepted connections."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{env=~\"$env\", app=~\"$app\", host=~\"$host\"}[$__rate_interval])) or sum by (app) (rate(http_request_duration_seconds_count{env=~\"$env\", app=~\"$app\", host=~\"$host\"}[$__rate_interval])) or sum by (app) (rate(phpfpm_accepted_connections{env=~\"$env\", app=~\"$app\", host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx / s",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{env=~\"$env\", app=~\"$app\", host=~\"$host\", status=~\"5..\"}[$__rate_interval])) or sum by (app) (rate(http_server_requests_seconds_count{env=~\"$env\", app=~\"$app\", host=~\"$host\", code=~\"5..\"}[$__rate_interval])) or sum by (app) (rate(http_request_duration_seconds_count{env=~\"$env\", app=~\"$app\", host=~\"$host\", code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95 (Spring, Go, ASP.NET)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (app, le) (rate(http_server_requests_seconds_bucket{env=~\"$env\", app=~\"$app\", host=~\"$host\"}[$__rate_interval]))) or histogram_quantile(0.95, sum by (app, le) (rate(http_request_duration_seconds_bucket{env=~\"$env\", app=~\"$app\", host=~\"$host\"}[$__rate_interval])))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "php-fpm processes (Laravel)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (app) (phpfpm_active_processes{env=~\"$env\", app=~\"$app\", host=~\"$host\"})",
          "legendFormat": "{{app}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (app) (phpfpm_idle_processes{env=~\"$env\", app=~\"$app\", host=~\"$host\"})",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU busy",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{env=~\"$env\", app=~\"$app\", host=~\"$host\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{env=~\"$env\", app=~\"$app\", host=~\"$host\"} / node_memory_MemTotal_bytes{env=~\"$env\", app=~\"$app\", host=~\"$host\"})",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Root disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{env=~\"$env\", app=~\"$app\", host=~\"$host\", mountpoint=\"/\"} / node_filesystem_size_bytes{env=~\"$env\", app=~\"$app\", host=~\"$host\", mountpoint=\"/\"})",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"journal\", env=~\"$env\", app=~\"$app\", host=~\"$host\"} |~ \"$search\""
        }
      ]
    }
  ]
}
