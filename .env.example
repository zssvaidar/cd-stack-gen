# Copy to .env for local `docker compose up` only. Never populate this for
# staging/prod - those get secrets from Vault at container start (see
# docker/php/docker-entrypoint.sh and docs/vault-secret-injection.md).

PHP_VERSION=8.3
APP_ENV=local

# Leave all VAULT_* unset to run fully local with no Vault - the entrypoint
# then loads app/.env instead (create one from app/.env.example if you add
# app-level config later; the mock app itself needs no secrets to boot).
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_PATH=
