# Template for project-9/wrapper/dev/laravel/.env (gitignored). Copy it, fill in real values, then
#   ../project-15/run.sh secrets dev laravel push
# Every variable becomes a SecureString at /cd-stack-gen/dev/laravel/<KEY>.

APP_KEY=base64:generate-with-php-artisan-key-generate-show
DB_CONNECTION=mysql
DB_HOST=mydb.xxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change-me
