# cp .env.example .env  (.env is gitignored)

# Hostname/IP people and git clients use to reach this box, e.g. 192.168.0.30 or gitlab.lan.
# "localhost" only works from this machine itself.
GITLAB_HOST=localhost
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224

# First boot only; min 8 chars and not a common password or GitLab rejects it and generates one.
# Leave empty to use the generated one in /etc/gitlab/initial_root_password.
GITLAB_ROOT_PASSWORD=

# Pin both in real use; keep the runner on the same major.minor as GitLab.
GITLAB_VERSION=latest
RUNNER_VERSION=latest

# From Admin -> CI/CD -> Runners -> New instance runner (glrt-...). Tags are set there too.
RUNNER_TOKEN=
RUNNER_NAME=docker-runner
RUNNER_DEFAULT_IMAGE=alpine:3
