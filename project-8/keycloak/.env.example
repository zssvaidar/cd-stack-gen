KEYCLOAK_VERSION=26.4
POSTGRES_VERSION=17

KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=

# initial admin user - only created on first start against an empty DB
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=

# public URL Keycloak is reached at (include scheme; https:// when behind a TLS proxy)
KC_HOSTNAME=http://localhost:8080
KC_PROXY_HEADERS=xforwarded

KC_HTTP_PORT=8080
KC_MGMT_PORT=9000
