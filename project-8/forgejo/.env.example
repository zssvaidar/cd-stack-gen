# cp .env.example .env  (.env is gitignored)

# This machine's LAN IP or hostname - NOT localhost. It's baked into clone URLs, and job
# containers use it for actions/checkout; "localhost" inside a job container is the container.
FORGEJO_HOST=192.168.0.30
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# Created on first boot. "admin" is a reserved name in Forgejo - pick something else.
FORGEJO_ADMIN_USER=forgejo_admin
FORGEJO_ADMIN_PASSWORD=change-me-please
FORGEJO_ADMIN_EMAIL=admin@example.com
# true = only the admin can create accounts
FORGEJO_DISABLE_REGISTRATION=true

# Shared secret that registers the runner with no UI step: exactly 40 hex chars.
#   openssl rand -hex 20
RUNNER_SECRET=
RUNNER_NAME=docker-runner
# "<runs-on label>:docker://<image jobs run in>", comma separated. node image because
# JavaScript actions (actions/checkout, ...) need node inside the job container.
RUNNER_LABELS=docker:docker://node:20-bookworm,bun-hydrate-deploy:docker://node:20-bookworm
RUNNER_CAPACITY=1

# 15 is the current LTS line (supported to July 2027)
FORGEJO_VERSION=15
RUNNER_VERSION=13
